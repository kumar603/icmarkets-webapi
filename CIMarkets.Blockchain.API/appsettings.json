{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.EntityFrameworkCore": "Information"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=blockchain.db"
  },
  "BlockCypher": {
    "BaseUrl": "https://api.blockcypher.com/v1",
    "ApiKey": "${BLOCKCYPHER_API_KEY}",
    "TimeoutSeconds": 30
  }
}
